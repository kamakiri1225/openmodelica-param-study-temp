// ============================================================
//  eva1 run_sim.mos  (Windows OpenModelica)
//  使い方(eva フォルダ内で):
//    "C:\\Program Files\\OpenModelica1.26.3-64bit\\bin\\omc.exe" run_sim.mos
//  出力: ana002_Tank3blocks_002_machineAreaTankMist_NoTemp_res.csv (time, tank1/2/3.medium.T [K])
//  その後  python compare.py  で実測と比較
// ============================================================
loadModel(Modelica); getErrorString();
loadFile("model/ana002_Tank3blocks_002_machineAreaTankMist_NoTemp.mo"); getErrorString();
simulate(ana002_Tank3blocks_002_machineAreaTankMist_NoTemp,
  stopTime          = 20000,
  numberOfIntervals = 2000,
  outputFormat      = "csv",
  variableFilter    = "time|tank1.medium.T|tank2.medium.T|tank3.medium.T");
getErrorString();
