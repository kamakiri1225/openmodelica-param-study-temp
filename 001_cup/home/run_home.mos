// 桶水加熱(自宅版)を回す:  このフォルダ(home/)内で  omc.exe run_home.mos
loadModel(Modelica); getErrorString();
loadFile("CupHotWater_15W_home.mo"); getErrorString();
simulate(CupHotWater_15W_home, stopTime=3600, numberOfIntervals=360,
  outputFormat="csv", variableFilter="time|y_sim_T|y_exp_T|cup.medium.T|cup.level");
getErrorString();
